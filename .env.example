# RetinaSense AI — environment configuration (copy to `.env`)
# All values are optional; defaults match docker-compose.yml.

# --- Postgres ---
# POSTGRES_PASSWORD=change-me-in-production

# --- Backend ---
# Strong random value:  python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=change-me-in-production
# CORS_ORIGINS=["https://your-domain.example"]
# DEBUG=false

# --- Published ports (host side) ---
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
